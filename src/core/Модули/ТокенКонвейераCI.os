#Использовать logos

// id-token конвейера GitHub Actions или GitLab CI: хаб принимает его вместо токена публикации.

// Получает id-token конвейера: из переменной среды (GitLab CI) либо у сервиса токенов GitHub Actions.
//
// Параметры:
//  Сервер - СерверПакетов - сервер публикации; его адрес - аудитория по умолчанию.
//  Аудитория - Строка - аудитория id-token в GitHub Actions; пустая - адрес сервера.
//  ИмяПеременной - Строка - переменная среды с id-token из блока id_tokens GitLab CI.
//  Соединение - HTTPСоединение - соединение с сервисом токенов GitHub; Неопределено - по его адресу.
//
// Возвращаемое значение:
//  Строка - id-token.
//
Функция Получить(Знач Сервер, Знач Аудитория = "", Знач ИмяПеременной = "", Знач Соединение = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ИмяПеременной) Тогда
		Токен = ПолучитьПеременнуюСреды(ИмяПеременной);
		Если Не ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение СтрШаблон("Переменная среды %1 с id-token пуста: в .gitlab-ci.yml нужен блок id_tokens с ней",
				ИмяПеременной);
		КонецЕсли;
		Возврат Токен;
	КонецЕсли;

	АдресСервиса = ПолучитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_URL");
	ТокенЗапроса = ПолучитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_TOKEN");
	Если Не ЗначениеЗаполнено(АдресСервиса) Или Не ЗначениеЗаполнено(ТокенЗапроса) Тогда
		ВызватьИсключение "Конвейер не выдал id-token: в GitHub Actions нужно permissions: id-token: write,"
			+ " в GitLab CI - блок id_tokens и имя его переменной в опции <--trusted-token-var>";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Аудитория) Тогда
		Аудитория = Сервер.АдресДляСообщений();
	КонецЕсли;

	КонецХоста = СтрНайти(АдресСервиса, "/", , СтрНайти(АдресСервиса, "://") + 3);
	Хост = Лев(АдресСервиса, КонецХоста - 1);
	Ресурс = Сред(АдресСервиса, КонецХоста);
	Ресурс = Ресурс + ?(СтрНайти(Ресурс, "?") > 0, "&", "?")
		+ "audience=" + КодироватьСтроку(Аудитория, СпособКодированияСтроки.КодировкаURL);

	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Authorization", "bearer " + ТокенЗапроса);

	Если Соединение = Неопределено Тогда
		Соединение = Новый HTTPСоединение(Хост);
	КонецЕсли;

	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		Логирование.ПолучитьЛог("oscript.app.opm").Отладка("Запрос id-token к %1 не удался: %2", Хост, ОписаниеОшибки());
		ВызватьИсключение СтрШаблон("Не удалось подключиться к %1", Хост);
	КонецПопытки;

	Тело = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Сервис id-token GitHub ответил кодом %1: %2", Ответ.КодСостояния, Тело);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Токен = ПрочитатьJSON(Чтение, Истина)["value"];
	Чтение.Закрыть();

	Если Не ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "В ответе сервиса id-token GitHub нет поля value";
	КонецЕсли;

	Возврат Токен;

КонецФункции
