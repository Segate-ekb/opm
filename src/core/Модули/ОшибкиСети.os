// Перевод исключений HTTP-соединения в причину для пользователя.

// Причина неудачного обращения к серверу одной фразой.
//
// Параметры:
//  ТекстОшибки - Строка - ОписаниеОшибки() платформы.
//
// Возвращаемое значение:
//  Строка - причина: имя не разрешается, соединение отклонено, таймаут, TLS и т.п.
//
Функция Причина(Знач ТекстОшибки) Экспорт

	Сообщение = Суть(ТекстОшибки);
	Текст = НРег(Сообщение);

	Если Содержит(Текст, "nodename nor servname")
		ИЛИ Содержит(Текст, "no such host")
		ИЛИ Содержит(Текст, "name or service not known")
		ИЛИ Содержит(Текст, "getaddrinfo")
		ИЛИ Содержит(Текст, "host not found")
		ИЛИ Содержит(Текст, "nameresolution") Тогда
		Возврат "имя хоста не разрешается";
	КонецЕсли;

	Если Содержит(Текст, "connection refused") ИЛИ Содержит(Текст, "actively refused") Тогда
		Возврат "соединение отклонено — по этому адресу никто не слушает";
	КонецЕсли;

	Если Содержит(Текст, "timed out") ИЛИ Содержит(Текст, "timeout") Тогда
		Возврат "истекло время ожидания ответа";
	КонецЕсли;

	Если Содержит(Текст, "ssl") ИЛИ Содержит(Текст, "tls")
		ИЛИ Содержит(Текст, "certificate") ИЛИ Содержит(Текст, "secure channel") Тогда
		Возврат "не удалось установить защищённое соединение (TLS)";
	КонецЕсли;

	Если Содержит(Текст, "unreachable") Тогда
		Возврат "сеть недоступна";
	КонецЕсли;

	Если Содержит(Текст, "forcibly closed") ИЛИ Содержит(Текст, "connection reset") Тогда
		Возврат "соединение разорвано другой стороной";
	КонецЕсли;

	Возврат ?(ПустаяСтрока(Сообщение), "соединение не установлено", Сообщение);

КонецФункции

// Сообщение о неудачном подключении к серверу.
//
// Параметры:
//  Адрес - Строка - адрес сервера.
//  ТекстОшибки - Строка - ОписаниеОшибки() платформы.
//
// Возвращаемое значение:
//  Строка - "Не удалось подключиться к <адрес>: <причина>".
//
Функция НеУдалосьПодключиться(Знач Адрес, Знач ТекстОшибки) Экспорт

	Возврат СтрШаблон("Не удалось подключиться к %1: %2", Адрес, Причина(ТекстОшибки));

КонецФункции

// Текст исключения без служебной обёртки платформы: имени модуля, номера строки и типа .NET-исключения.
//
// Параметры:
//  ТекстОшибки - Строка - ОписаниеОшибки() платформы.
//
// Возвращаемое значение:
//  Строка - суть сообщения.
//
Функция Суть(Знач ТекстОшибки) Экспорт

	Исходный = СокрЛП(Строка(ТекстОшибки));

	// тело ответа хаба тоже начинается с фигурной скобки, поэтому нужны обе приметы
	Если НЕ СтрНачинаетсяС(Исходный, "{Модуль ") ИЛИ СтрНайти(Исходный, " / Error in line") = 0 Тогда
		Возврат Исходный;
	КонецЕсли;

	Значение = СокрЛП(СтрЗаменить(СтрЗаменить(Исходный, Символы.ПС, " "), Символы.ВК, ""));
	Если СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Значение = СокрЛП(Лев(Значение, СтрДлина(Значение) - 1));
	КонецЕсли;

	// "{Модуль …/Файл.os / Error in line: 69 / текст}"
	Позиция = СтрНайти(Значение, " / ", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Значение = СокрЛП(Сред(Значение, Позиция + 3));
	КонецЕсли;

	// "Внешнее исключение (System.Net.WebException): текст"
	Позиция = СтрНайти(Значение, "):");
	Если СтрНачинаетсяС(Значение, "Внешнее исключение") И Позиция > 0 Тогда
		Значение = СокрЛП(Сред(Значение, Позиция + 2));
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция Содержит(Знач Текст, Знач Подстрока)
	Возврат СтрНайти(Текст, Подстрока) > 0;
КонецФункции
