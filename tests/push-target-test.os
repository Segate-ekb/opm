#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"
#Использовать "../src/cmd"

Перем юТест;
Перем Пуш;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ПубликоватьВПулИзОпцииХаба");
	СписокТестов.Добавить("ТестДолжен_ОтказатьНаПутиВОпцииХаба");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьВПулХабаПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьНаСерверИзНастроекПоИмени");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьВХабПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ОтправитьТокенИФайлВЗапросеПубликации");
	СписокТестов.Добавить("ТестДолжен_НеОтправлятьТокенСерверуСоСвоейАвторизацией");
	СписокТестов.Добавить("ТестДолжен_ПоказатьСообщениеХабаПриОтказе");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	Пуш = Новый КомандаOpm_Push();
	НастройкиOpm.СброситьНастройки();
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	НастройкиOpm.СброситьНастройки();
	ВременныеФайлы.Удалить();
КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВПулИзОпцииХаба() Экспорт

	Сервер = Пуш.СерверПубликации("127.0.0.1:3380", "", "corp");

	Ожидаем.Что(Сервер.Сервер).Равно("http://127.0.0.1");
	Ожидаем.Что(Сервер.Порт).Равно(3380);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ОтказатьНаПутиВОпцииХаба() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("hub.example/corp");
	Параметры.Добавить("");

	Ожидаем.Что(Пуш).Метод("СерверПубликации", Параметры).ВыбрасываетИсключение("без пути, пул задаётся опцией --pool");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВПулХабаПоУмолчанию() Экспорт

	Сервер = Пуш.СерверПубликации("", "", "corp");

	Ожидаем.Что(Сервер.Сервер).Равно("http://hub.oscript.io");
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьНаСерверИзНастроекПоИмени() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("corp", "https://hub.example", , "/api/v1/pools/corp/push"));

	Ожидаем.Что(Пуш.СерверПубликации("", "corp").РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВХабПоУмолчанию() Экспорт

	Сервер = Пуш.СерверПубликации("", "");

	Ожидаем.Что(Сервер.Сервер).Равно(КонстантыOpm.СерверУдаленногоХранилища);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно(КонстантыOpm.РесурсПубликацииПакетов);

КонецПроцедуры

Процедура ТестДолжен_ОтправитьТокенИФайлВЗапросеПубликации() Экспорт

	Сервер = Пуш.СерверПубликации("hub.example", "", "corp");
	ФайлПакета = ФайлПакетаПробы();

	Запрос = Сервер.ЗапросПубликации(ФайлПакета, "stable", "токен");

	Ожидаем.Что(Запрос.АдресРесурса).Равно("/api/v1/pools/corp/push");
	Ожидаем.Что(Запрос.Заголовки["FILE-NAME"]).Равно(ФайлПакета.Имя);
	Ожидаем.Что(Запрос.Заголовки["CHANNEL"]).Равно("stable");
	Ожидаем.Что(Запрос.Заголовки["OAUTH-TOKEN"]).Равно("токен");

КонецПроцедуры

Процедура ТестДолжен_НеОтправлятьТокенСерверуСоСвоейАвторизацией() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("corp", "https://hub.example", , , 0, 0, "Bearer из настроек"));

	Запрос = Пуш.СерверПубликации("hub.example", "", "corp").ЗапросПубликации(ФайлПакетаПробы(), "", "токен");

	Ожидаем.Что(Запрос.Заголовки["Authorization"]).Равно("Bearer из настроек");
	Ожидаем.Что(Запрос.Заголовки["OAUTH-TOKEN"]).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолжен_ПоказатьСообщениеХабаПриОтказе() Экспорт

	Ответ = ЗагрузитьЗаглушку("ЗаглушкаОтветаХаба.os");
	Ответ.КодСостояния = 409;
	Ответ.Тело = "{""КодСостояние"": 409, ""Сообщение"": ""Версия 1.0.0 уже опубликована""}";
	Сервер = ЗагрузитьЗаглушку("ЗаглушкаСервераПакетов.os");
	Сервер.Отвечать(Ответ);

	Параметры = Новый Массив;
	Параметры.Добавить("токен");
	Параметры.Добавить(ФайлПакетаПробы());
	Параметры.Добавить("");
	Параметры.Добавить(Сервер);

	Ожидаем.Что(Пуш).Метод("ОтправитьПакетВХаб", Параметры).ВыбрасываетИсключение("Версия 1.0.0 уже опубликована");

	Ответ.Тело = "Bad Gateway";
	Ожидаем.Что(Пуш).Метод("ОтправитьПакетВХаб", Параметры).ВыбрасываетИсключение("Bad Gateway");

КонецПроцедуры

Функция ФайлПакетаПробы()

	ПутьКФайлу = ВременныеФайлы.НовоеИмяФайла("ospx");
	Запись = Новый ЗаписьТекста(ПутьКФайлу);
	Запись.Записать("содержимое пакета");
	Запись.Закрыть();

	Возврат Новый Файл(ПутьКФайлу);

КонецФункции

Функция ЗагрузитьЗаглушку(Знач ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла));
КонецФункции
